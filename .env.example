# App
APP_ENV=development
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://mneme:mneme@localhost:5432/mneme

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mneme-assets
S3_ACCESS_KEY=mneme
S3_SECRET_KEY=mneme_secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Auth (generate for local dev: openssl rand -hex 32)
JWT_SECRET=replace_me_with_32_byte_hex

# AI (Phase 3)
AI_PROVIDER=openai
AI_API_KEY=
